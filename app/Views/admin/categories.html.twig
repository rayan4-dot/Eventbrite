{% extends 'layouts/admin.html.twig' %}

{% block title %} Eventbrite-Dashboard {% endblock %}

{% block content %}
    <!-- Categories Table -->
    <div class="p-6">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-bold text-white">Categories</h2>
            <!-- Add Category Button -->
            <button id="addCategoryButton" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
                Add Category
            </button>
        </div>

        <!-- Modal Structure -->
        <div id="CategoryModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden">
            <div class="bg-gray-800 p-6 rounded-lg w-full max-w-md">
                <h3 class="text-xl font-bold text-white mb-4">Add Category</h3>
                <form id="categoryForm" action="" method="POST" class="w-full">
                    <div class="mb-4">
                        <input
                                type="text"
                                name="name"
                                placeholder="Category Name"
                                class="px-4 py-2 bg-gray-700 text-white rounded-lg w-full"
                                value="{{ model.name }}"
                                required/>
                        {% if errors and errors.name %}
                            <div class="text-red-500 text-xs">{{ errors.name[0] }}</div>
                        {% endif %}
                    </div>
                    <div class="mb-4">
                        <input
                                type="text"
                                name="description"
                                placeholder="Category Description"
                                class="px-4 py-2 bg-gray-700 text-white rounded-lg w-full"
                                value="{{ model.description }}"
                        />
                    </div>
                    <div class="flex justify-end">
                        <button type="submit" id="save-category"
                                class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
                            Save
                        </button>
                        <button type="button" id="closeModalButton"
                                class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 ml-2">
                            Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Edit Category Modal -->
        <div id="editCategoryModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden">
            <div class="bg-gray-800 p-6 rounded-lg w-full max-w-md">
                <h3 class="text-xl font-bold text-white mb-4">Edit Category</h3>
                <form id="editCategoryForm" action="" method="POST">
                    <div class="mb-4">
                        <input type="text" id="editCategoryName" name="name" placeholder="Category Name"
                               class="px-4 py-2 bg-gray-700 text-white rounded-lg w-full" required/>
                    </div>
                    <div class="mb-4">
                        <input type="text" id="editCategoryDescription" name="description" placeholder="Category Description"
                               class="px-4 py-2 bg-gray-700 text-white rounded-lg w-full"/>
                    </div>
                    <div class="flex justify-end">
                        <button type="submit" id="update-btn" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
                            Save Changes
                        </button>
                        <button type="button" id="closeEditModal" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 ml-2">
                            Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="bg-gray-800 rounded-lg shadow-lg border border-gray-700">
            <table class="w-full">
                <thead>
                <tr class="border-b border-gray-700">
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Category
                        Name
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Total
                        Events
                    </th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-400 uppercase tracking-wider">
                        Actions
                    </th>
                </tr>
                </thead>
                <tbody id="categoryTableBody" class="divide-y divide-gray-700"></tbody>
            </table>
        </div>
    </div>
{% endblock %}
{% block scripts %}
    <script src="/assets/js/script.js"></script>
{% endblock %}