{% extends 'layouts/authLayout.twig' %}

{% block title  %}Register - Eventbrite{% endblock %}


{% block header %} Create an account {% endblock %}
{% block description %} Sign up to access the best events near you. {% endblock %}

{% block formContent %}

{% import 'macros/input.twig' as form %}

    {{ form.inputField('firstName', 'text', 'First Name', model.firstName, '', model.errors) }}
    {{ form.inputField('lastName', 'text', 'Last Name', model.lastName, '', model.errors) }}
    {{ form.inputField('email', 'email', 'Email', model.email, '', model.errors) }}
    {{ form.inputField('password', 'password', 'Password', model.password, '', model.errors) }}
    {{ form.inputField('confirmPassword', 'password', 'Confirm Password', model.confirmPassword, '', model.errors) }}

    <button
            type="submit"
            class="w-full bg-[#d1410c] hover:bg-[#b83a0b] text-white font-bold py-3 px-4 rounded-lg transition duration-200"
    >
        Sign up
    </button>

{% endblock %}