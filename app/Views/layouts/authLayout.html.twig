<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@latest/dist/full.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/style.css">


</head>
<body class="min-h-screen">
<div class="bg-image"></div>
<div class="overlay"></div>

<!-- Header with Logo -->
<header class="w-full bg-white/90 backdrop-blur-sm shadow-sm py-4">
    <div class="container mx-auto px-4">
        <img src="/assets/images/logo.png" alt="Eventbrite" class="h-9"/>
    </div>
</header>

<main class="container mx-auto px-4 py-12">
    <div class="max-w-[400px] mx-auto">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-white">{% block header %} {% endblock %}</h1>
            <p class="mt-2 text-white/80">{% block description %} {% endblock %}.</p>
        </div>

        <div class="bg-white/95 backdrop-blur-sm p-8 rounded-lg shadow-xl">
            <form class="space-y-6" method="post">
                {% block formContent %} {% endblock %}
            </form>

            <div class="mt-6">
                <div class="relative">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-gray-300"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="px-2 bg-white text-gray-500">Or continue with</span>
                    </div>
                </div>

                <div class="mt-6 grid grid-cols-2 gap-3">
                    <button class="flex items-center justify-center px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50">
                        <img src="/assets/images/Google_2015_logo.webp"
                             style="width: 76px; margin: 19px;" alt="Google logo" class="mr-2"/>
                    </button>
                    <button class="flex items-center justify-center px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50">
                        <img src="/assets/images/Facebook-Logo-2019.png"
                             style="width: 76px; margin: 19px;" alt="Facebook logo" class="mr-2"/>
                    </button>
                </div>
            </div>

            <div class="mt-6 text-center">
                <p class="text-[#39364f]">
                    Already have an account?
                    <a href="" class="text-[#3659e3] hover:text-[#1f35a6] font-semibold">Log in</a>
                </p>
            </div>
        </div>
    </div>
</main>

<footer class="mt-12 py-8">
    <div class="container mx-auto px-4 text-center text-sm text-white">
        <p>
            By clicking "Sign up" or "Sign up with Google/Facebook", you agree to Eventbrite's
            <a href="#" class="text-white hover:text-gray-200 underline">Terms of Service</a> and acknowledge you have
            read the
            <a href="#" class="text-white hover:text-gray-200 underline">Privacy Policy</a>. You agree to receive emails
            about events on Eventbrite.
        </p>
    </div>
</footer>
</body>
</html>