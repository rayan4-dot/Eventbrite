{% macro inputField(name, type, label, value, class, errors) %}
    <div class="form-control">
        <label class="label">
            <span class="text-gray-300 font-medium">{{ label }}</span>
        </label>
        <input name="{{ name }}" type="{{ type }}" value="{{ value }}" class="input input-dark w-full {{ class }} {{ errors[name] ? 'border-red-500' : 'border-gray-300'}}"/>
    </div>
    {% if errors[name] %}
        <div class="text-red-500 text-sm mt-2">
            {{ errors[name][0] }}
        </div>
    {% endif %}
{% endmacro %}