{% macro inputField(name, type, label, value, class, errors) %}

    <div>
        <label class="block text-[#39364f] text-[14px] font-semibold mb-2">
            {{ label }}
        </label>
        <input
            type="{{ type }}"
            name="{{ name }}"
            value="{{ value }}"
            class="w-full px-4 py-3 border-2 border-[#dbdae3] rounded-lg focus:border-[#3659e3] focus:ring-0 text-[#39364f] {{ class }} {{ errors[name] ? 'border-red-500' : 'border-gray-300'}}"
        />
        {% if errors[name] %}
        <div class="text-red-500 text-sm mt-2">
            {{ errors[name][0] }}
        </div>
        {% endif %}
    </div>

{% endmacro %}