{% macro pictureField(label, name, errors = '') %}
<div class="relative group">
    <div class="border-2 border-dashed border-gray-600 rounded-lg p-8 text-center hover:border-orange-600 transition-colors bg-gray-900">
        <i class="fas fa-cloud-upload-alt text-4xl text-gray-400 mb-4"></i>
        <div class="space-y-2">
            <label class="block text-sm font-medium text-gray-300">{{ label }}</label>
            <div class="text-xs text-gray-400">Drag and drop or click to upload</div>
            <input name="{{ name }}" type="file" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer "/>
        </div>
    </div>
    {% if errors[name] is defined %}
        <div class="text-red-500 text-xs mt-1">{{ errors[name][0] }}</div>
    {% endif %}
</div>
{% endmacro %}