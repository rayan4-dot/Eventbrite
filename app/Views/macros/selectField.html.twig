{% macro selectField(name, label, value, options, class = '', errors = null) %}
    <div class="form-control">
        <label class="label">
            <span class="text-gray-300 font-medium">{{ label }}</span>
        </label>
        <select name="{{ name }}" id="{{ name }}" class="select select-dark w-full {{ class }}">
            {% for option_value, option_label in options %}
                <option value="{{ option_value }}" {% if option_value == value %}selected{% endif %}>
                    {{ option_label }}
                </option>
            {% endfor %}
        </select>

        {% if errors is not empty %}
            <div class="text-red-500 text-xs mt-1">{{ errors }}</div>
        {% endif %}
    </div>
{% endmacro %}
