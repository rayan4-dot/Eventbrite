{% macro selectField(name, id, label, value, options, class = '', errors = null) %}
    <div class="form-control">
        <label class="label">
            <span class="text-gray-300 font-medium">{{ label }}</span>
        </label>
        <select name="{{ name }}" id="{{ id }}" class="select bg-gray-800 border-gray-700 focus:border-orange-600 select-dark w-full {{ class }}">
            <option disabled selected>Select</option>
            {% for option_label, option_value in options %}
                <option value="{{ option_value }}" {% if option_value == value %}selected{% endif %}>
                    {{ option_label }}
                </option>
            {% endfor %}
        </select>

        {% if errors[name] is defined %}
            <div class="text-red-500 text-sm mt-1">{{ errors[name][0] }}</div>
        {% endif %}
    </div>
{% endmacro %}
