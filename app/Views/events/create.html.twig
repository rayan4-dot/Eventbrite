<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Event - Tailwind AI</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@latest/dist/full.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(90deg, rgba(247, 135, 6, 0.8) 0%, rgba(179, 149, 122, 0.4) 100%),
            theme('colors.orange.600');
        }
        .close {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
        }
        .btn  {
            background-color: rgb(234, 88, 12);
            border-color: rgb(234, 88, 12);
            color: #fff;
        }
        .close:hover,
        .close:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }
    </style>
</head>
<body class="min-h-screen p-8">
<div class="max-w-4xl mx-auto bg-white/90 rounded-xl shadow-2xl p-8">
    <h1 class="text-3xl font-bold text-center mb-8 text-orange-600">Create New Event</h1>

    <form id="eventForm" class="space-y-6">
        <!-- Event Picture Upload -->
        <div class="form-control">
            <label class="label">
                <span class="label-text font-semibold">Event Picture</span>
            </label>
            <input type="file" class="file-input file-input-bordered file-input-primary w-full" />
        </div>

        <!-- Event Title -->
        <div class="form-control">
            <label class="label">
                <span class="label-text font-semibold">Event Title</span>
            </label>
            <input type="text" placeholder="Enter event title" class="input input-bordered" />
        </div>

        <!-- Event Details Grid -->
        <div class="grid md:grid-cols-2 gap-6">
            <!-- Event Date & Time -->
            <div class="form-control">
                <label class="label">
                    <span class="label-text font-semibold">Event Date & Time</span>
                </label>
                <input type="datetime-local" class="input input-bordered" />
            </div>

            <!-- Event Location -->
            <div id="locationSection" class="form-control">
                <label class="label">
                    <span class="label-text font-semibold">Event Location</span>
                </label>
                <input type="text" placeholder="Enter event location" class="input input-bordered" />
            </div>
        </div>

        <!-- Event Description -->
        <div class="form-control">
            <label class="label">
                <span class="label-text font-semibold">Event Description</span>
            </label>
            <textarea class="textarea textarea-bordered h-24" placeholder="Describe your event..."></textarea>
        </div>

        <!-- Event Duration -->
        <div id="eventDurationSection" class="form-control">
            <label class="label">
                <span class="label-text font-semibold">Event Duration (hours)</span>
            </label>
            <input type="number" placeholder="Enter duration" class="input input-bordered" min="0" step="0.1" />
        </div>

        <!-- Event Type and Seats -->
        <div class="grid md:grid-cols-2 gap-6">
            <!-- Seats Number -->
            <div class="form-control">
                <label class="label">
                    <span class="label-text font-semibold">Number of Seats</span>
                </label>
                <input type="number" placeholder="Total seats" class="input input-bordered" min="1" />
            </div>

            <!-- Event Type -->
            <div class="form-control">
                <label class="label">
                    <span class="label-text font-semibold">Event Type</span>
                </label>
                <select id="eventType" class="select select-bordered">
                    <option disabled selected>Select Event Type</option>
                    <option value="face-to-face">Face to Face</option>
                    <option value="remote">Remote (Google Meet)</option>
                </select>
            </div>
        </div>

        <!-- Google Meet Link (Conditional) -->
        <div id="googleMeetSection" class="form-control hidden">
            <label class="label">
                <span class="label-text font-semibold">Google Meet Link</span>
            </label>
            <input type="url" placeholder="Enter Google Meet link" class="input input-bordered" />
        </div>

        <!-- Pricing -->
        <div class="form-control">
            <label class="label cursor-pointer">
                <span class="label-text font-semibold">Is this a paid event?</span>
                <input id="isPaidEvent" type="checkbox" class="toggle toggle-primary" />
            </label>
        </div>

        <!-- Price Range (Conditional) -->
        <div id="pricingSection" class="grid md:grid-cols-2 gap-6 hidden">
            <div class="form-control">
                <label class="label">
                    <span class="label-text font-semibold">Price</span>
                </label>
                <input type="number" placeholder="Event price" class="input input-bordered" min="0" step="0.01" />
            </div>
            <div class="form-control">
                <label class="label">
                    <span class="label-text font-semibold">Currency</span>
                </label>
                <select class="select select-bordered">
                    <option>USD ($)</option>
                    <option>EUR (€)</option>
                    <option>MAD (DH)</option>
                </select>
            </div>
        </div>

        <!-- Sponsors -->
        <div class="form-control">
            <label class="label">
                <span class="label-text font-semibold">Event Sponsors</span>
            </label>
            <div class="flex items-center gap-4">
                <button type="button" id="openSponsorModal" class="btn btn-primary">
                    <i class="fas fa-plus mr-2"></i>Add Sponsor
                </button>
            </div>

            <!-- Sponsors List -->
            <div id="sponsorsList" class="mt-4">
                <select id="existingSponsors" class="select select-bordered w-full">
                    <option disabled selected>Select Existing Sponsors</option>
                </select>
            </div>
        </div>

        <!-- Submit Button -->
        <div class="form-control mt-6">
            <button class="btn btn-primary">Create Event</button>
        </div>
    </form>
</div>

<!-- Sponsor Modal -->
<dialog id="sponsorModal" class="modal">
    <div class="modal-box">
        <span id="closeSponsorModal" class="close">&times;</span>
        <h3 class="font-bold text-lg">Add Sponsor</h3>
        <div class="form-control">
            <label class="label">
                <span class="label-text">Sponsor Logo</span>
            </label>
            <input type="file" id="sponsorLogo" class="file-input file-input-bordered file-input-primary w-full" />
        </div>
        <div class="form-control">
            <label class="label">
                <span class="label-text">Sponsor Name</span>
            </label>
            <input type="text" id="sponsorName" placeholder="Enter sponsor name" class="input input-bordered" />
        </div>
        <div class="modal-action">
            <button id="addSponsorBtn" class="btn btn-primary">Add Sponsor</button>
        </div>
    </div>
</dialog>

<script>
    document.addEventListener('DOMContentLoaded', (event) => {
        // Modal Elements
        const modal = document.getElementById('sponsorModal');
        const openButton = document.getElementById('openSponsorModal');
        const closeButton = document.getElementById('closeSponsorModal');
        const addSponsorBtn = document.getElementById('addSponsorBtn');

        // Conditional Sections
        const eventTypeSelect = document.getElementById('eventType');
        const googleMeetSection = document.getElementById('googleMeetSection');
        const locationSection = document.getElementById('locationSection');
        const eventDurationSection = document.getElementById('eventDurationSection');
        const isPaidEventToggle = document.getElementById('isPaidEvent');
        const pricingSection = document.getElementById('pricingSection');
        const existingSponsorsSelect = document.getElementById('existingSponsors');

        // Sponsors Array
        let sponsors = [];

        // Event Type Conditional Display
        eventTypeSelect.addEventListener('change', (e) => {
            if (e.target.value === 'remote') {
                locationSection.classList.add('hidden');
                googleMeetSection.classList.remove('hidden');
            } else {
                locationSection.classList.remove('hidden');
                googleMeetSection.classList.add('hidden');
            }
        });

        // Paid Event Conditional Display
        isPaidEventToggle.addEventListener('change', (e) => {
            pricingSection.classList.toggle('hidden', !e.target.checked);
        });

        // Sponsor Modal Functions
        openButton.addEventListener('click', () => modal.showModal());
        closeButton.addEventListener('click', () => modal.close());

        // Add Sponsor
        addSponsorBtn.addEventListener('click', () => {
            const sponsorName = document.getElementById('sponsorName').value;
            const sponsorLogo = document.getElementById('sponsorLogo').files[0];

            if (sponsorName) {
                // Add sponsor to array
                sponsors.push({
                    name: sponsorName,
                    logo: sponsorLogo ? URL.createObjectURL(sponsorLogo) : null
                });

                // Update sponsors dropdown
                updateSponsorsDropdown();

                // Clear input fields
                document.getElementById('sponsorName').value = '';
                document.getElementById('sponsorLogo').value = '';

                // Close modal
                modal.close();
            }
        });

        // Update Sponsors Dropdown
        function updateSponsorsDropdown() {
            // Clear existing options
            existingSponsorsSelect.innerHTML = '<option disabled selected>Select Existing Sponsors</option>';

            // Add new sponsors
            sponsors.forEach((sponsor, index) => {
                const option = document.createElement('option');
                option.value = index;
                option.textContent = sponsor.name;
                existingSponsorsSelect.appendChild(option);
            });
        }
    });
</script>
</body>
</html>
